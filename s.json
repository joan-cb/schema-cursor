{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    },
    "city": {
      "type": "string"
    },
    "isStudent": {
      "type": "boolean"
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "zip"
      ]
    },
    "phoneNumbers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "type"
        ]
      }
    }
  },
  "required": [
    "address",
    "age",
    "city",
    "grades",
    "isStudent",
    "name",
    "phoneNumbers"
  ]
}